{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=assignment_system;Username=postgres;Password=root"
  },
  "Jwt": {
    "Issuer": "AssignmentSystem",
    "Audience": "AssignmentSystemClient",
    "SigningKey": "replace-with-a-long-random-secret-at-least-32-characters",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  }
}
